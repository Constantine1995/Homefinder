# The service reads AGENT_* variables; in Docker, compose.yaml sets the database and the token.
AGENT_TOKEN=change-me
AGENT_DATABASE_URL=postgresql://homefinder:secret@127.0.0.1:5432/homefinder
# pytest runs against the test database of the Laravel suite.
AGENT_TEST_DATABASE_URL=postgresql://homefinder:secret@127.0.0.1:5432/homefinder_testing
# The language model, through LiteLLM.
# AGENT_LLM_MODEL=ollama_chat/qwen2.5:7b
# qwen3 thinks before answering unless told not to:
# AGENT_LLM_MODEL=ollama_chat/qwen3:8b
# AGENT_LLM_REASONING_EFFORT=none
# Ollama unloads the model after 5 idle minutes; loading it again on a laptop can outlast Laravel's timeout.
# AGENT_LLM_KEEP_ALIVE=30m
